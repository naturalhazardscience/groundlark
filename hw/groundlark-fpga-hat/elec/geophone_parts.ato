# Racotech RGI-4.5Hz single differential input. Physical PW/DCK pin maps.
#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import ElectricPower

component GEO_ADC:
    analog = new ElectricPower
    analog.hv ~ p12
    analog.lv ~ p5
    assert analog.voltage within 2.3V to 5.5V
    digital = new ElectricPower
    digital.hv ~ p13
    digital.lv ~ p4
    assert digital.voltage within 2.3V to 5.5V
    trait is_atomic_part<manufacturer="See BOM", partnumber="ADS122C04IPWR", footprint="../../shared/elec/Package_SO__TSSOP-16_4.4x5mm_P0.65mm.kicad_mod", symbol="../../shared/elec/symbols/GEO_ADC.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    signal p13 ~ pin 13
    signal p14 ~ pin 14
    signal p15 ~ pin 15
    signal p16 ~ pin 16

component GEO_CONN:
    trait is_atomic_part<manufacturer="See BOM", partnumber="1803280", footprint="../../shared/elec/Connector_Phoenix_MC__PhoenixContact_MC_1,5_3-G-3.81_1x03_P3.81mm_Horizontal.kicad_mod", symbol="../../shared/elec/symbols/GEO_CONN.kicad_sym">
    trait has_designator_prefix<prefix="J">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3

component GEO_ESD:
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="TPD2E2U06QDCKRQ1", footprint="../../shared/elec/Package_TO_SOT_SMD__SOT-323_SC-70.kicad_mod", symbol="../../shared/elec/symbols/GEO_ESD.kicad_sym">
    trait has_designator_prefix<prefix="D">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3

component GEO_R1K:
    resistance: ohm
    resistance = 1kohm +/- 1%
    trait is_atomic_part<manufacturer="See BOM", partnumber="RC0603FR-071KL", footprint="../../shared/elec/Resistor_SMD__R_0603_1608Metric.kicad_mod", symbol="../../shared/elec/symbols/GEO_R1K.kicad_sym">
    trait has_designator_prefix<prefix="R">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component GEO_R1M:
    resistance: ohm
    resistance = 1Mohm +/- 1%
    trait is_atomic_part<manufacturer="See BOM", partnumber="RC0603FR-071ML", footprint="../../shared/elec/Resistor_SMD__R_0603_1608Metric.kicad_mod", symbol="../../shared/elec/symbols/GEO_R1M.kicad_sym">
    trait has_designator_prefix<prefix="R">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component GEO_R22:
    resistance: ohm
    resistance = 22ohm +/- 1%
    trait is_atomic_part<manufacturer="See BOM", partnumber="RC0603FR-0722RL", footprint="../../shared/elec/Resistor_SMD__R_0603_1608Metric.kicad_mod", symbol="../../shared/elec/symbols/GEO_R22.kicad_sym">
    trait has_designator_prefix<prefix="R">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component GEO_C100N:
    capacitance: F
    capacitance = 100nF +/- 5%
    rated_voltage: V
    rated_voltage = 50V
    trait is_atomic_part<manufacturer="See BOM", partnumber="C3216C0G1H104J160AA", footprint="../../shared/elec/Capacitor_SMD__C_1206_3216Metric.kicad_mod", symbol="../../shared/elec/symbols/GEO_C100N.kicad_sym">
    trait has_designator_prefix<prefix="C">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component GEO_C1N:
    capacitance: F
    capacitance = 1nF +/- 5%
    rated_voltage: V
    rated_voltage = 50V
    trait is_atomic_part<manufacturer="See BOM", partnumber="C0603C102J5GACTU", footprint="../../shared/elec/Capacitor_SMD__C_0603_1608Metric.kicad_mod", symbol="../../shared/elec/symbols/GEO_C1N.kicad_sym">
    trait has_designator_prefix<prefix="C">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
