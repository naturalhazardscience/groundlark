# GNSS RF interface. MAX-M10S itself uses shared P_12.
#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix

component GNSS_SMA:
    trait is_atomic_part<manufacturer="HenryTech", partnumber="HL-SMA-KWE-02", footprint="../../shared/elec/GNSS_HL_SMA_KWE_02.kicad_mod", symbol="../../shared/elec/symbols/GNSS_SMA.kicad_sym">
    trait has_designator_prefix<prefix="J">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component GNSS_47P:
    trait is_atomic_part<manufacturer="Murata", partnumber="GRM1555C1H470JA01D", footprint="../../shared/elec/GNSS_C0402.kicad_mod", symbol="../../shared/elec/symbols/GNSS_47P.kicad_sym">
    trait has_designator_prefix<prefix="C">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component GNSS_27N:
    trait is_atomic_part<manufacturer="Murata", partnumber="LQW15AN27NJ00D", footprint="../../shared/elec/GNSS_L0402.kicad_mod", symbol="../../shared/elec/symbols/GNSS_27N.kicad_sym">
    trait has_designator_prefix<prefix="L">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component GNSS_ESD:
    trait is_atomic_part<manufacturer="Nexperia", partnumber="PESD5V0F1BL,315", footprint="../../shared/elec/GNSS_SOD882.kicad_mod", symbol="../../shared/elec/symbols/GNSS_ESD.kicad_sym">
    trait has_designator_prefix<prefix="D">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component GNSS_LIMIT:
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="TPS2553DBVR", footprint="../../shared/elec/GNSS_SOT23_6.kicad_mod", symbol="../../shared/elec/symbols/GNSS_LIMIT.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6

component GNSS_4U7:
    trait is_atomic_part<manufacturer="Murata", partnumber="GRM21BR71C475KA73L", footprint="../../shared/elec/Capacitor_SMD__C_0805_2012Metric.kicad_mod", symbol="../../shared/elec/symbols/GNSS_4U7.kicad_sym">
    trait has_designator_prefix<prefix="C">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component GNSS_56N:
    trait is_atomic_part<manufacturer="Coilcraft", partnumber="0402HPH-56NXJRW", footprint="../../shared/elec/GNSS_HP0402.kicad_mod", symbol="../../shared/elec/symbols/GNSS_56N.kicad_sym">
    trait has_designator_prefix<prefix="L">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component GNSS_3N6:
    trait is_atomic_part<manufacturer="Coilcraft", partnumber="0402HP-3N6XJRW", footprint="../../shared/elec/GNSS_HP0402.kicad_mod", symbol="../../shared/elec/symbols/GNSS_3N6.kicad_sym">
    trait has_designator_prefix<prefix="L">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
