    u21.power ~ pi_supply
    u21.io ~ pi_supply

    signal GNSS_LDO
    trait GNSS_LDO has_net_name_suggestion<name="GNSS_LDO", level="EXPECTED">
    # TPS2553 DBV: ILIM tied IN selects 50..100 mA, below L140's 280 mA rating.
    u141 = new GNSS_LIMIT
    trait u141 has_designator<designator="U141">
    u141.p1 ~ GNSS_LDO
    u141.p2 ~ GND
    u141.p3 ~ GNSS_LDO
    u141.p5 ~ GNSS_LDO
    u141.p6 ~ GNSS_BIAS
    # Unused open-drain FAULT pin 4 is deliberately unconnected.
    signal GNSS_FAULT_NC
    trait GNSS_FAULT_NC has_net_name_suggestion<name="GNSS_FAULT_NC", level="EXPECTED">
    u141.p4 ~ GNSS_FAULT_NC
    c151 = new SUP_10N
    trait c151 has_designator<designator="C151">
    c151.p1 ~ GNSS_BIAS
    c151.p2 ~ GND
    c152 = new P_6
    trait c152 has_designator<designator="C152">
    c152.p1 ~ GNSS_LDO
    c152.p2 ~ GND
