module TrenzHat:
    signal BAT_INPUT
    trait BAT_INPUT has_net_name_suggestion<name="BAT_INPUT", level="EXPECTED">
    signal BAT_FUSED
    trait BAT_FUSED has_net_name_suggestion<name="BAT_FUSED", level="EXPECTED">
    signal BAT_PROTECTED
    trait BAT_PROTECTED has_net_name_suggestion<name="BAT_PROTECTED", level="EXPECTED">
    signal SUP_3V3
    trait SUP_3V3 has_net_name_suggestion<name="SUP_3V3", level="EXPECTED">
    signal SUP_NRST
    trait SUP_NRST has_net_name_suggestion<name="SUP_NRST", level="EXPECTED">
    signal SUP_CORE
    trait SUP_CORE has_net_name_suggestion<name="SUP_CORE", level="EXPECTED">
    signal SUP_SWDIO
    trait SUP_SWDIO has_net_name_suggestion<name="SUP_SWDIO", level="EXPECTED">
    signal SUP_SWCLK
    trait SUP_SWCLK has_net_name_suggestion<name="SUP_SWCLK", level="EXPECTED">
    signal SUP_BAT_ADC
    trait SUP_BAT_ADC has_net_name_suggestion<name="SUP_BAT_ADC", level="EXPECTED">
    signal SUP_RUN_DRIVE
    trait SUP_RUN_DRIVE has_net_name_suggestion<name="SUP_RUN_DRIVE", level="EXPECTED">
    signal SUP_RUN
    trait SUP_RUN has_net_name_suggestion<name="SUP_RUN", level="EXPECTED">
    signal SUP_REQUEST
    trait SUP_REQUEST has_net_name_suggestion<name="SUP_REQUEST", level="EXPECTED">
    signal SUP_ACK_N
    trait SUP_ACK_N has_net_name_suggestion<name="SUP_ACK_N", level="EXPECTED">
    signal PI_SHUTDOWN_N
    trait PI_SHUTDOWN_N has_net_name_suggestion<name="PI_SHUTDOWN_N", level="EXPECTED">
    signal PI_HALTED
    trait PI_HALTED has_net_name_suggestion<name="PI_HALTED", level="EXPECTED">
    signal PI_BUCK_FB
    trait PI_BUCK_FB has_net_name_suggestion<name="PI_BUCK_FB", level="EXPECTED">
    signal PI_RAW_5V
    trait PI_RAW_5V has_net_name_suggestion<name="PI_RAW_5V", level="EXPECTED">
    signal PI_SWITCH_CT
    trait PI_SWITCH_CT has_net_name_suggestion<name="PI_SWITCH_CT", level="EXPECTED">
    signal LINK_ARMED_REQUEST
    signal FPGA_LINK_CS_N
    signal FPGA_LINK_DQ0
    signal FPGA_LINK_DQ1
    signal FPGA_LINK_DQ2
    signal FPGA_LINK_DQ3
    signal FPGA_LINK_SCLK
    signal LINK_CS_N
    signal LINK_DQ0
    signal LINK_DQ1
    signal LINK_DQ2
    signal LINK_DQ3
    signal LINK_FPGA_GOOD
    signal LINK_JTAG_SEL
    signal LINK_OE_N
    signal LINK_PI_GOOD
    signal LINK_REQUEST
    signal LINK_SCLK
    signal PI_LINK_CS_N
    signal PI_LINK_DQ0
    signal PI_LINK_DQ1
    signal PI_LINK_DQ2
    signal PI_LINK_DQ3
    signal PI_LINK_SCLK
    signal EEP_WP
    signal EXT_12V
    signal FUSED_12V
    signal PROTECTED_12V
    signal BUCK_EN
    signal BUCK_FB
    signal FPGA_3V3
    signal FPGA_CONFIG_RESET_N
    signal FPGA_EN1
    signal FPGA_IO_ENABLE
    signal FPGA_JTAGEN
    signal FPGA_MODE
    signal FPGA_NOSEQ
    signal FPGA_PGOOD
    signal FPGA_RESET_GATE
    signal FPGA_RESET_GPIO
    signal FPGA_RESET_N
    signal FPGA_UART_DRIVE
    signal FPGA_UART_RX
    signal FPGA_UART_TX
    signal FPGA_VIN
    signal GND
    signal GEO_DRDY_N
    signal GEO_P
    signal GEO_N
    signal GEO_AIN_P
    signal GEO_AIN_N
    signal GEO_VCM
    signal GEO_AVDD
    signal I2C_SCL
    signal I2C_SDA
    signal ID_SCL
    signal ID_SDA
    signal IMU1_CS
    signal IMU1_INT
    signal IMU2_CS
    signal IMU2_INT
    signal IMU3_CS
    signal IMU3_INT
    signal JTAG_TCK
    signal JTAG_TDI
    signal JTAG_TDO
    signal JTAG_TMS
    signal PI_3V3
    signal PI_5V
    signal PI_GEO_DRDY_N
    signal PI_I2C_SCL
    signal PI_I2C_SDA
    signal PI_IMU1_CS
    signal PI_IMU1_INT
    signal PI_IMU2_CS
    signal PI_IMU2_INT
    signal PI_IMU3_CS
    signal PI_IMU3_INT
    signal PI_SPI_MISO
    signal PI_SPI_MOSI
    signal PI_SPI_SCLK
    signal PI_UART_RX
    signal PI_UART_TX
    signal SENSOR_OE_N
    signal SENS_3V3
    signal SPI_MISO
    signal SPI_MOSI
    signal SPI_SCLK

    sensor_supply = new ElectricPower
    sensor_supply.hv ~ SENS_3V3
    sensor_supply.lv ~ GND
    sensor_supply.voltage = 3.18V to 3.42V
    assert sensor_supply.voltage within 3.0V to 3.6V
    pi_supply = new ElectricPower
    pi_supply.hv ~ PI_3V3
    pi_supply.lv ~ GND
    pi_supply.voltage = 3.135V to 3.465V
    input_supply = new ElectricPower
    input_supply.hv ~ PI_5V
    input_supply.lv ~ GND
    input_supply.voltage = 4.75V to 5.25V
    assert input_supply.voltage within 4.0V to 5.5V

    # 01-host-power
    # Raspberry Pi 40-pin: Samtec ESQ-120-23-G-D
    j1 = new P_1
    trait j1 has_designator<designator="J1">
    j1.p1 ~ PI_3V3
    j1.p2 ~ PI_5V
    j1.p3 ~ PI_I2C_SDA
    j1.p4 ~ PI_5V
    j1.p5 ~ PI_I2C_SCL
    j1.p6 ~ GND
    j1.p7 ~ PI_GEO_DRDY_N
    j1.p8 ~ PI_UART_TX
    j1.p9 ~ GND
    j1.p10 ~ PI_UART_RX
    j1.p11 ~ FPGA_RESET_GPIO
    j1.p12 ~ PI_LINK_CS_N
    j1.p13 ~ PI_IMU1_INT
    j1.p14 ~ GND
    j1.p15 ~ PI_IMU2_INT
    j1.p16 ~ PI_IMU3_INT
    j1.p17 ~ PI_3V3
    j1.p18 ~ GNSS_PPS
    j1.p19 ~ PI_SPI_MOSI
    j1.p20 ~ GND
    j1.p21 ~ PI_SPI_MISO
    j1.p22 ~ FPGA_IO_ENABLE
    j1.p23 ~ PI_SPI_SCLK
    j1.p24 ~ PI_IMU1_CS
    j1.p25 ~ GND
    j1.p26 ~ PI_IMU2_CS
    j1.p27 ~ ID_SDA
    j1.p28 ~ ID_SCL
    j1.p29 ~ PI_IMU3_CS
    j1.p30 ~ GND
    j1.p31 ~ PI_SHUTDOWN_N
    j1.p32 ~ PI_LINK_DQ3
    j1.p33 ~ PI_HALTED
    j1.p34 ~ GND
    j1.p35 ~ PI_LINK_DQ1
    j1.p36 ~ PI_LINK_DQ2
    j1.p37 ~ SENSOR_OE_N
    j1.p38 ~ PI_LINK_DQ0
    j1.p39 ~ GND
    j1.p40 ~ PI_LINK_SCLK
    # 24LC32A: 24LC32A-I/SN
    u1 = new P_2
    trait u1 has_designator<designator="U1">
    u1.p1 ~ GND
    u1.p2 ~ GND
    u1.p3 ~ GND
    u1.p4 ~ GND
    u1.p5 ~ ID_SDA
    u1.p6 ~ ID_SCL
    u1.p7 ~ EEP_WP
    u1.p8 ~ PI_3V3
    # 3.9k: RC0603FR-073K9L
    r1 = new P_3
    trait r1 has_designator<designator="R1">
    r1.p1 ~ ID_SDA
    r1.p2 ~ PI_3V3
    # 3.9k: RC0603FR-073K9L
    r2 = new P_3
    trait r2 has_designator<designator="R2">
    r2.p1 ~ ID_SCL
    r2.p2 ~ PI_3V3
    # 1k: RC0603FR-071KL
    r3 = new P_4
    trait r3 has_designator<designator="R3">
    r3.p1 ~ EEP_WP
    r3.p2 ~ PI_3V3
    # EEPROM write enable: EEPROM write enable
    jp1 = new P_5
    trait jp1 has_designator<designator="JP1">
    jp1.p1 ~ EEP_WP
    jp1.p2 ~ GND
    # 100n: GRM188R71H104KA93D
    c1 = new P_6
    trait c1 has_designator<designator="C1">
    c1.p1 ~ PI_3V3
    c1.p2 ~ GND
    # 10u: GRM21BR61A106KE19L
    c2 = new P_7
    trait c2 has_designator<designator="C2">
    c2.p1 ~ PI_3V3
    c2.p2 ~ GND
    # 10u: GRM21BR61A106KE19L
    c3 = new P_7
    trait c3 has_designator<designator="C3">
    c3.p1 ~ PI_5V
    c3.p2 ~ GND

    # 02-motion-array
    # LSM6DSOTR: LSM6DSOTR
    u11 = new P_8
    trait u11 has_designator<designator="U11">
    u11.p1 ~ SPI_MISO
    u11.p2 ~ GND
    u11.p3 ~ GND
    u11.p4 ~ IMU1_INT
    u11.p5 ~ SENS_3V3
    u11.p6 ~ GND
    u11.p7 ~ GND
    u11.p8 ~ SENS_3V3
    # U11.9: intentionally unconnected
    # U11.10: intentionally unconnected
    # U11.11: intentionally unconnected
    u11.p12 ~ IMU1_CS
    u11.p13 ~ SPI_SCLK
    u11.p14 ~ SPI_MOSI
    # 100n: GRM155R71C104KA88D
    c12 = new P_9
    trait c12 has_designator<designator="C12">
    c12.p1 ~ SENS_3V3
    c12.p2 ~ GND
    # 100n: GRM155R71C104KA88D
    c13 = new P_9
    trait c13 has_designator<designator="C13">
    c13.p1 ~ SENS_3V3
    c13.p2 ~ GND
    # 10k: RC0603FR-0710KL
    r11 = new P_10
    trait r11 has_designator<designator="R11">
    r11.p1 ~ IMU1_CS
    r11.p2 ~ SENS_3V3
    # LSM6DSOTR: LSM6DSOTR
    u12 = new P_8
    trait u12 has_designator<designator="U12">
    u12.p1 ~ SPI_MISO
    u12.p2 ~ GND
    u12.p3 ~ GND
    u12.p4 ~ IMU2_INT
    u12.p5 ~ SENS_3V3
    u12.p6 ~ GND
    u12.p7 ~ GND
    u12.p8 ~ SENS_3V3
    # U12.9: intentionally unconnected
    # U12.10: intentionally unconnected
    # U12.11: intentionally unconnected
    u12.p12 ~ IMU2_CS
    u12.p13 ~ SPI_SCLK
    u12.p14 ~ SPI_MOSI
    # 100n: GRM155R71C104KA88D
    c14 = new P_9
    trait c14 has_designator<designator="C14">
    c14.p1 ~ SENS_3V3
    c14.p2 ~ GND
    # 100n: GRM155R71C104KA88D
    c15 = new P_9
    trait c15 has_designator<designator="C15">
    c15.p1 ~ SENS_3V3
    c15.p2 ~ GND
    # 10k: RC0603FR-0710KL
    r12 = new P_10
    trait r12 has_designator<designator="R12">
    r12.p1 ~ IMU2_CS
    r12.p2 ~ SENS_3V3
    # LSM6DSOTR: LSM6DSOTR
    u13 = new P_8
    trait u13 has_designator<designator="U13">
    u13.p1 ~ SPI_MISO
    u13.p2 ~ GND
    u13.p3 ~ GND
    u13.p4 ~ IMU3_INT
    u13.p5 ~ SENS_3V3
    u13.p6 ~ GND
    u13.p7 ~ GND
    u13.p8 ~ SENS_3V3
    # U13.9: intentionally unconnected
    # U13.10: intentionally unconnected
    # U13.11: intentionally unconnected
    u13.p12 ~ IMU3_CS
    u13.p13 ~ SPI_SCLK
    u13.p14 ~ SPI_MOSI
    # 100n: GRM155R71C104KA88D
    c16 = new P_9
    trait c16 has_designator<designator="C16">
    c16.p1 ~ SENS_3V3
    c16.p2 ~ GND
    # 100n: GRM155R71C104KA88D
    c17 = new P_9
    trait c17 has_designator<designator="C17">
    c17.p1 ~ SENS_3V3
    c17.p2 ~ GND
    # 10k: RC0603FR-0710KL
    r13 = new P_10
    trait r13 has_designator<designator="R13">
    r13.p1 ~ IMU3_CS
    r13.p2 ~ SENS_3V3
    # 03-geophone: passive vertical Racotech RGI-4.5Hz, 395 ohm, 23.4 V/(m/s).
    # Internal PGA/reference; no borrowed Raspberry Shake low-frequency extension.
    u22 = new GEO_ADC
    trait u22 has_designator<designator="U22">
    u22.p1 ~ GND
    u22.p2 ~ GND
    u22.p3 ~ SENS_3V3
    u22.p4 ~ GND
    u22.p5 ~ GND
    u22.p10 ~ GEO_AIN_N
    u22.p11 ~ GEO_AIN_P
    u22.p12 ~ GEO_AVDD
    u22.p13 ~ SENS_3V3
    u22.p14 ~ GEO_DRDY_N
    u22.p15 ~ I2C_SDA
    u22.p16 ~ I2C_SCL
    j90 = new GEO_CONN
    trait j90 has_designator<designator="J90">
    j90.p1 ~ GEO_P
    j90.p2 ~ GEO_N
    j90.p3 ~ GND
    d90 = new GEO_ESD
    trait d90 has_designator<designator="D90">
    d90.p1 ~ GEO_P
    d90.p2 ~ GEO_N
    d90.p3 ~ GND
    r90 = new GEO_R1K
    trait r90 has_designator<designator="R90">
    r90.p1 ~ GEO_P
    r90.p2 ~ GEO_AIN_P
    r91 = new GEO_R1K
    trait r91 has_designator<designator="R91">
    r91.p1 ~ GEO_N
    r91.p2 ~ GEO_AIN_N
    c90 = new GEO_C100N
    trait c90 has_designator<designator="C90">
    c90.p1 ~ GEO_AIN_P
    c90.p2 ~ GEO_AIN_N
    c91 = new GEO_C1N
    trait c91 has_designator<designator="C91">
    c91.p1 ~ GEO_AIN_P
    c91.p2 ~ GND
    c92 = new GEO_C1N
    trait c92 has_designator<designator="C92">
    c92.p1 ~ GEO_AIN_N
    c92.p2 ~ GND
    r92 = new GEO_R1M
    trait r92 has_designator<designator="R92">
    r92.p1 ~ GEO_AIN_P
    r92.p2 ~ GEO_VCM
    r93 = new GEO_R1M
    trait r93 has_designator<designator="R93">
    r93.p1 ~ GEO_AIN_N
    r93.p2 ~ GEO_VCM
    r94 = new P_10
    trait r94 has_designator<designator="R94">
    r94.p1 ~ GEO_AVDD
    r94.p2 ~ GEO_VCM
    r95 = new P_10
    trait r95 has_designator<designator="R95">
    r95.p1 ~ GEO_VCM
    r95.p2 ~ GND
    c93 = new P_7
    trait c93 has_designator<designator="C93">
    c93.p1 ~ GEO_VCM
    c93.p2 ~ GND
    r96 = new GEO_R22
    trait r96 has_designator<designator="R96">
    r96.p1 ~ SENS_3V3
    r96.p2 ~ GEO_AVDD
    c94 = new P_7
    trait c94 has_designator<designator="C94">
    c94.p1 ~ GEO_AVDD
    c94.p2 ~ GND
    c95 = new P_6
    trait c95 has_designator<designator="C95">
    c95.p1 ~ GEO_AVDD
    c95.p2 ~ GND
    c96 = new P_6
    trait c96 has_designator<designator="C96">
    c96.p1 ~ SENS_3V3
    c96.p2 ~ GND
    r97 = new P_10
    trait r97 has_designator<designator="R97">
    r97.p1 ~ GEO_DRDY_N
    r97.p2 ~ SENS_3V3

    # 04-remote-sensors
    # 100n: GRM188R71H104KA93D
    # 100n: GRM188R71H104KA93D
    # 390: RC0603FR-07390RL
    # 120: RC0603FR-07120RL
    # 390: RC0603FR-07390RL
    # 390: RC0603FR-07390RL
    # 120: RC0603FR-07120RL
    # 390: RC0603FR-07390RL
    # 05-fpga-interface
    # 47: RC0603FR-0747RL
    # 47: RC0603FR-0747RL
    # 47: RC0603FR-0747RL
    # FPGA UART service ONLY
    j4 = new P_20
    trait j4 has_designator<designator="J4">
    j4.p1 ~ GND
    j4.p2 ~ FPGA_UART_RX
    j4.p3 ~ FPGA_UART_TX
    j4.p4 ~ FPGA_RESET_N

    # 06-supply-isolation
    # TLV1117LV33DCYR: TLV1117LV33DCYR
    u40 = new P_21
    trait u40 has_designator<designator="U40">
    u40.p1 ~ GND
    u40.p2 ~ SENS_3V3
    u40.p3 ~ PI_5V
    # 10u: GRM21BR61A106KE19L
    c40 = new P_7
    trait c40 has_designator<designator="C40">
    c40.p1 ~ PI_5V
    c40.p2 ~ GND
    # 100n: GRM188R71H104KA93D
    c41 = new P_6
    trait c41 has_designator<designator="C41">
    c41.p1 ~ PI_5V
    c41.p2 ~ GND
    # 22u: GRM31CR61A226KE19L
    c42 = new P_22
    trait c42 has_designator<designator="C42">
    c42.p1 ~ SENS_3V3
    c42.p2 ~ GND
    # 100n: GRM188R71H104KA93D
    c43 = new P_6
    trait c43 has_designator<designator="C43">
    c43.p1 ~ SENS_3V3
    c43.p2 ~ GND
    # SN74LVC8T245PWR: SN74LVC8T245PWR
    u41 = new P_23
    trait u41 has_designator<designator="U41">
    u41.p1 ~ PI_3V3
    u41.p2 ~ PI_3V3
    u41.p11 ~ GND
    u41.p12 ~ GND
    u41.p13 ~ GND
    u41.p22 ~ SENSOR_OE_N
