# Sensirion SDP3x digital v1.1, pages 4, 11 and 12.
#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import ElectricPower

component PRESSURE_SDP32:
    power = new ElectricPower
    power.hv ~ p7
    power.lv ~ p6
    assert power.voltage within 2.7V to 5.5V
    trait is_atomic_part<manufacturer="Sensirion", partnumber="SDP32-125PA-TR-250PCS", footprint="../../shared/elec/Groundlark__SDP32.kicad_mod", symbol="../../shared/elec/symbols/PRESSURE_SDP32.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    signal p13 ~ pin 13
    signal p14 ~ pin 14
    signal p15 ~ pin 15
    signal p16 ~ pin 16
    signal p17 ~ pin 17
