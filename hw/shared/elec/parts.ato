    signal p2 ~ pin 2  # SDx
    signal p3 ~ pin 3  # SCx
    signal p4 ~ pin 4  # INT1
    signal p5 ~ pin 5  # VDDIO
    signal p6 ~ pin 6  # GND
    signal p7 ~ pin 7  # GND
    signal p8 ~ pin 8  # VDD
    signal p9 ~ pin 9  # INT2
    signal p10 ~ pin 10  # OCS_AUX
    signal p11 ~ pin 11  # SDO_AUX
    signal p12 ~ pin 12  # CS
    signal p13 ~ pin 13  # SCLK
    signal p14 ~ pin 14  # SDI

